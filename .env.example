CPL_APP_NAME=Carrom Premier League API
CPL_APP_ENV=dev
CPL_APP_HOST=127.0.0.1
CPL_APP_PORT=8000
CPL_APP_ALLOWED_HOSTS=http://localhost:5179

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CPL_AUTH_JWT_SECRET=replace-with-a-long-random-secret
CPL_AUTH_TOKEN_EXPIRE_MINUTES=60

# SQL Server connection. Keep the real password in your local .env only.
CPL_DB_HOST=localhost
CPL_DB_PORT=1433
CPL_DB_USER=sa
CPL_DB_PWD=
CPL_DB_NAME=CPLDB
CPL_DB_POOL_SIZE=5
