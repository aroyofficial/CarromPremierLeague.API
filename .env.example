CPL_APP_NAME=Carrom Premier League API
CPL_APP_ENV=dev
CPL_APP_HOST=127.0.0.1
CPL_APP_PORT=8000
# The live site on GitHub Pages also needs https://aroyofficial.github.io in this list.
CPL_APP_ALLOWED_HOSTS=http://localhost:5179

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CPL_AUTH_JWT_SECRET=replace-with-a-long-random-secret
CPL_AUTH_TOKEN_EXPIRE_MINUTES=60

# Phone verification for +91 numbers. "off" (default) sends nothing and marks no phone as verified.
# "dev" only works when CPL_APP_ENV=dev and sends nothing. No production SMS provider exists yet.
CPL_PHONE_OTP_PROVIDER=off

# Realtime change notices (public stream and private admin stream). Leave unset until one API process should push updates.
# A second process will not share subscribers. The web build needs VITE_REALTIME_ENABLED=true too.
CPL_REALTIME_ENABLED=false

# SQL Server connection. Keep the real password in your local .env only.
CPL_DB_HOST=localhost
CPL_DB_PORT=1433
CPL_DB_USER=sa
CPL_DB_PWD=
CPL_DB_NAME=CPLDB
CPL_DB_POOL_SIZE=5

# Player and team pictures. Copy the "API environment variable" from the Cloudinary dashboard.
# Leave empty to run without uploads. Keep the folder the same as Render's while both use the same database.
CPL_CLOUDINARY_URL=
CPL_MEDIA_FOLDER=cpl

# Optional Striker provider. A Cursor user or service-account key from Dashboard → API Keys.
# Used only after Gemini, Groq, and OpenRouter. Leave the model empty for the account default.
CPL_CURSOR_API_KEY=
CPL_CURSOR_MODEL=

# Match alerts and calendars. Leave these off until the database tables exist.
# Push needs a VAPID key pair from `npx web-push generate-vapid-keys`.
# Put the public key and the private key in the two variables below. Do not commit the private key.
# CPL_VAPID_SUBJECT is a mailto: or https: contact for the push service.
CPL_PUSH_ENABLED=false
CPL_VAPID_PUBLIC_KEY=
CPL_VAPID_PRIVATE_KEY=
CPL_VAPID_SUBJECT=mailto:cpl@localhost

# A subscribable calendar feed. No third-party account is required.
CPL_CALENDAR_FEED_ENABLED=false

# Google and Microsoft account sync. Both stay off until a real OAuth client exists.
# CPL_OAUTH_REDIRECT_BASE is the public API origin, with no trailing path.
# CPL_CALENDAR_TOKEN_KEY is a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CPL_GOOGLE_CALENDAR_ENABLED=false
CPL_GOOGLE_CALENDAR_CLIENT_ID=
CPL_GOOGLE_CALENDAR_CLIENT_SECRET=
CPL_MICROSOFT_CALENDAR_ENABLED=false
CPL_MICROSOFT_CALENDAR_CLIENT_ID=
CPL_MICROSOFT_CALENDAR_CLIENT_SECRET=
CPL_OAUTH_REDIRECT_BASE=
CPL_CALENDAR_TOKEN_KEY=

# Staged rollout. "Match is live" alerts, and live or result rewrites of connected calendars.
CPL_PUSH_LIVE_ENABLED=false
CPL_CALENDAR_LIVE_UPDATES_ENABLED=false

# Set to false to stop the in-process sender without turning the features off.
CPL_NOTIFY_WORKER=true
